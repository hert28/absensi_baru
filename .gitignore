# ── Virtual Environment ──────────────────────────────────────
venv/
env/
.env/

# ── Konfigurasi Sensitif (berisi password) ───────────────────
# config.py sudah diubah menggunakan environment variables, jadi aman di-push
# config.py

# ── Data Wajah (privasi) — folder tetap ada, isi diabaikan ──
dataset/*
!dataset/.gitkeep

# ── Model LBPH — Di-commit agar Railway punya file model saat deploy
# Trainer.yml biasanya < 5MB, aman untuk git
# Jika ukuran terlalu besar, gunakan Railway Volume sebagai alternatif
!models/trainer.yml

# ── File Sementara Python ────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# ── File Sistem ───────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Log & Database Lokal ──────────────────────────────────────
*.log
*.db
*.sqlite3

# ── IDE ───────────────────────────────────────────────────────
.vscode/
.idea/
*.sublime-project